{
    "configurations": [
        {
            "name": "C#: Lopen - Atttach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "sourceFileMap": {
              "${workspaceFolder}": "${workspaceFolder}"
            }
        },
        {
          "name": "C#: Lopen - Launch",
          "type": "dotnet",
          "request": "launch",
          "projectPath": "${workspaceFolder}/src/Lopen/Lopen.csproj",
          "args": ["auth", "status"],
        }
    ]
}
